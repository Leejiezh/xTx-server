<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.leejie.xtx.core.mapper.RecordMapper">

    <!-- 标签计数（GET /record/label-counts）
         以 note_label 字典为基准 LEFT JOIN 当前用户笔记计数：返回全部启用标签（含 0 笔记），按 sortOrder 排序。
         计数子查询排除回收站（recycled_at IS NULL）与逻辑删除（deleted=0）；
         原始 SQL 不走 @TableLogic，deleted=0 必须显式写（与 /record/page 过滤口径一致）。
         extra 是 MySQL JSON 列，用 JsonMapTypeHandler 还原成 Map。 -->
    <resultMap id="LabelCountMap" type="com.leejie.xtx.core.dto.LabelCountVO">
        <result property="key" column="item_key"/>
        <result property="label" column="item_label"/>
        <result property="extra" column="extra" typeHandler="com.leejie.xtx.core.handler.JsonMapTypeHandler"/>
        <result property="count" column="cnt"/>
    </resultMap>

    <select id="countByLabel" resultMap="LabelCountMap">
        SELECT di.item_key,
               di.item_label,
               di.extra,
               COALESCE(c.cnt, 0) AS cnt
        FROM dict_item di
        LEFT JOIN (
            SELECT r.label, COUNT(*) AS cnt
            FROM record r
            WHERE r.user_id = #{userId}
              AND r.deleted = 0
              AND r.recycled_at IS NULL
              AND r.label IS NOT NULL
            GROUP BY r.label
        ) c ON c.label = di.item_key
        WHERE di.dict_type = #{typeCode}
          AND di.enabled = 1
        ORDER BY di.sort_order ASC, di.id ASC
    </select>

    <!-- 搜索（GET /search）：标题/正文 INSTR 字面子串匹配 + label 过滤，按 id 倒序。
         原始 SQL 不走 @TableLogic / OwnedService，user_id 归属、deleted=0、排除回收站
         必须显式写（口径与 /record/page 一致）；kw / label 空 = 不过滤。
         分页由 MyBatis-Plus 拦截器按第一个 IPage 参数自动生成 count + limit，这里不写。
         resultMap 引用实体的 autoResultMap（@TableName(autoResultMap=true)），
         images JSON 列才走 JsonListTypeHandler 反序列化成 List< >。 -->
    <select id="search" resultType="com.leejie.xtx.core.entity.Record">
        SELECT id, user_id, title, label, content, images, record_date, created_at, updated_at, recycled_at
        FROM record
        WHERE user_id = #{userId}
          AND deleted = 0
          AND recycled_at IS NULL
          <if test="kw != null and kw != ''">
              AND (INSTR(title, #{kw}) &gt; 0 OR INSTR(content, #{kw}) &gt; 0)
          </if>
          <if test="label != null and label != ''">
              AND label = #{label}
          </if>
        ORDER BY id DESC
    </select>

</mapper>
